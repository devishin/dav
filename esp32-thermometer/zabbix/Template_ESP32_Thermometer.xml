<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>5.0</version>
    <date>2026-09-28T12:00:00Z</date>
    <groups>
        <group>
            <name>Templates/IoT</name>
        </group>
    </groups>
    <templates>
        <template>
            <template>Template ESP32 Thermometer</template>
            <name>Template ESP32 Thermometer</name>
            <description>ESP32-S3 + DHT22 Wi-Fi thermometer — Zabbix 5.0 trapper (ZBXD sender push).</description>
            <groups>
                <group>
                    <name>Templates/IoT</name>
                </group>
            </groups>
            <applications>
                <application>
                    <name>Environment</name>
                </application>
                <application>
                    <name>Connectivity</name>
                </application>
                <application>
                    <name>Health</name>
                </application>
            </applications>
            <items>
                <item>
                    <name>Temperature</name>
                    <type>TRAP</type>
                    <key>thermometer.temperature</key>
                    <delay>0</delay>
                    <history>30d</history>
                    <trends>365d</trends>
                    <status>ENABLED</status>
                    <value_type>FLOAT</value_type>
                    <units>°C</units>
                    <applications>
                        <application>
                            <name>Environment</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>Humidity</name>
                    <type>TRAP</type>
                    <key>thermometer.humidity</key>
                    <delay>0</delay>
                    <history>30d</history>
                    <trends>365d</trends>
                    <status>ENABLED</status>
                    <value_type>FLOAT</value_type>
                    <units>%</units>
                    <applications>
                        <application>
                            <name>Environment</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>Wi-Fi RSSI</name>
                    <type>TRAP</type>
                    <key>thermometer.rssi</key>
                    <delay>0</delay>
                    <history>30d</history>
                    <trends>365d</trends>
                    <status>ENABLED</status>
                    <value_type>FLOAT</value_type>
                    <units>dBm</units>
                    <applications>
                        <application>
                            <name>Connectivity</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>Device uptime</name>
                    <type>TRAP</type>
                    <key>thermometer.uptime</key>
                    <delay>0</delay>
                    <history>30d</history>
                    <trends>365d</trends>
                    <status>ENABLED</status>
                    <value_type>UNSIGNED</value_type>
                    <units>s</units>
                    <applications>
                        <application>
                            <name>Health</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>Sensor OK</name>
                    <type>TRAP</type>
                    <key>thermometer.sensor_ok</key>
                    <delay>0</delay>
                    <history>30d</history>
                    <trends>365d</trends>
                    <status>ENABLED</status>
                    <value_type>UNSIGNED</value_type>
                    <valuemap>
                        <name>Thermometer sensor OK</name>
                    </valuemap>
                    <applications>
                        <application>
                            <name>Health</name>
                        </application>
                    </applications>
                </item>
                <item>
                    <name>Firmware version</name>
                    <type>TRAP</type>
                    <key>thermometer.firmware</key>
                    <delay>0</delay>
                    <history>7d</history>
                    <trends>0</trends>
                    <status>ENABLED</status>
                    <value_type>CHAR</value_type>
                    <applications>
                        <application>
                            <name>Health</name>
                        </application>
                    </applications>
                </item>
            </items>
            <macros>
                <macro>
                    <macro>{$TEMP.HIGH}</macro>
                    <value>30</value>
                </macro>
                <macro>
                    <macro>{$TEMP.LOW}</macro>
                    <value>5</value>
                </macro>
                <macro>
                    <macro>{$HUMIDITY.HIGH}</macro>
                    <value>80</value>
                </macro>
                <macro>
                    <macro>{$THERMO.NODATA}</macro>
                    <value>5m</value>
                </macro>
            </macros>
            <triggers>
                <trigger>
                    <expression>{Template ESP32 Thermometer:thermometer.temperature.last()}&gt;{$TEMP.HIGH}</expression>
                    <name>High temperature on {HOST.NAME}</name>
                    <priority>WARNING</priority>
                </trigger>
                <trigger>
                    <expression>{Template ESP32 Thermometer:thermometer.temperature.last()}&lt;{$TEMP.LOW}</expression>
                    <name>Low temperature on {HOST.NAME}</name>
                    <priority>WARNING</priority>
                </trigger>
                <trigger>
                    <expression>{Template ESP32 Thermometer:thermometer.humidity.last()}&gt;{$HUMIDITY.HIGH}</expression>
                    <name>High humidity on {HOST.NAME}</name>
                    <priority>WARNING</priority>
                </trigger>
                <trigger>
                    <expression>{Template ESP32 Thermometer:thermometer.sensor_ok.last()}=0</expression>
                    <name>Sensor failure on {HOST.NAME}</name>
                    <priority>HIGH</priority>
                </trigger>
                <trigger>
                    <expression>{Template ESP32 Thermometer:thermometer.temperature.nodata({$THERMO.NODATA})}=1</expression>
                    <name>No data from thermometer on {HOST.NAME}</name>
                    <priority>AVERAGE</priority>
                </trigger>
            </triggers>
            <graphs>
                <graph>
                    <name>Temperature</name>
                    <width>900</width>
                    <height>200</height>
                    <graph_items>
                        <graph_item>
                            <sortorder>0</sortorder>
                            <item>
                                <host>Template ESP32 Thermometer</host>
                                <key>thermometer.temperature</key>
                            </item>
                            <drawtype>GRADIENT_LINE</drawtype>
                        </graph_item>
                    </graph_items>
                </graph>
                <graph>
                    <name>Humidity</name>
                    <width>900</width>
                    <height>200</height>
                    <graph_items>
                        <graph_item>
                            <sortorder>0</sortorder>
                            <item>
                                <host>Template ESP32 Thermometer</host>
                                <key>thermometer.humidity</key>
                            </item>
                            <drawtype>GRADIENT_LINE</drawtype>
                        </graph_item>
                    </graph_items>
                </graph>
                <graph>
                    <name>Wi-Fi RSSI</name>
                    <width>900</width>
                    <height>200</height>
                    <graph_items>
                        <graph_item>
                            <sortorder>0</sortorder>
                            <item>
                                <host>Template ESP32 Thermometer</host>
                                <key>thermometer.rssi</key>
                            </item>
                            <drawtype>GRADIENT_LINE</drawtype>
                        </graph_item>
                    </graph_items>
                </graph>
            </graphs>
        </template>
    </templates>
    <value_maps>
        <value_map>
            <name>Thermometer sensor OK</name>
            <mappings>
                <mapping>
                    <value>0</value>
                    <newvalue>Failed</newvalue>
                </mapping>
                <mapping>
                    <value>1</value>
                    <newvalue>OK</newvalue>
                </mapping>
            </mappings>
        </value_map>
    </value_maps>
</zabbix_export>
